# ============ BIMIPAL ENV EXAMPLE ============
# 1. Скопіюй цей файл у своє оточення (наприклад у .env або export у shell).
# 2. Заповни реальні значення.
# 3. НЕ коміть реальні значення в git — лише цей шаблон.

# --- Обов'язкові ---
# Токен Telegram-бота (від @BotFather)
BOT_TOKEN=123456789:AA_HERE_YOUR_TG_BOT_TOKEN

# Публічна URL, куди Monobank шле вебхуки (обов'язково закінчується на /webhook)
WEBHOOK_URL=https://mono.your-domain.pp.ua/webhook

# Ключ OpenRouter для AI-фіч (парсинг чеків, вечірні інсайти)
OPENROUTER_API_KEY=sk-or-v1-here-your-openrouter-key

# URL Telegram Mini App (BimiApp)
APP_URL=https://bimiapp.your-domain.pp.ua

# Спільний внутрішній ключ до бекенду BimiFinance (ТАКИЙ САМИЙ, як BOT_API_KEY у BimiFinance .env).
# Генерація: openssl rand -hex 32
BOT_API_KEY=hex-here-64-chars

# Чат/канал адміна для щоденних бекапів БД (відправляються о 03:00). Можна лишити порожнім.
ADMIN_TELEGRAM_CHAT_ID=123456789

# --- Опціональні (мають дефолти) ---
# Базовий URL бекенду BimiFinance (FastAPI)
API_BASE_URL=https://bimif.vshevchuk.pp.ua

# Моделі ШІ (можна змінювати)
AI_TEXT_MODEL=openrouter/free
AI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
